{
  "name": "@printhub/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi/printhub-openapi.json -o src/generated/schema.ts",
    "build": "npm run generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.12.1"
  },
  "devDependencies": {
    "openapi-typescript": "^6.7.2",
    "typescript": "^5.6.3"
  }
}
