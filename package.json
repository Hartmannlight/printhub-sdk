{
  "name": "@printhub/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Generated and curated TypeScript client for the PrintHub API",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openapi",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "generate": "openapi-typescript openapi/printhub-openapi.json -o src/generated/schema.ts",
    "build": "npm run generate && tsc -p tsconfig.json",
    "check:generated": "node scripts/check-generated.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "ci": "npm run check:generated && npm run typecheck && npm run build && npm run audit",
    "prepack": "npm run ci"
  },
  "dependencies": {
    "openapi-fetch": "^0.12.1"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.3"
  }
}
